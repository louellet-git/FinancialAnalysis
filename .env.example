# Names only. Copy this file to .env (not in git). Do not commit values.
# Each key is optional: a command that needs a missing key says so, and the other commands work.
FMP_API_KEY=
TIINGO_API_KEY=
# Alpaca Market Data API (free plan; a paper account is enough): both values are needed.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Optional: the feed of the stock data (iex, the default, is the only feed of the free plan).
# APCA_DATA_FEED=iex
# Optional: the address of the Alpaca trading API that lists the option contracts (default: the paper address).
# APCA_API_BASE_URL=https://paper-api.alpaca.markets
# FRED API (free key at fredaccount.stlouisfed.org). With it the FRED loaders use the API first.
FRED_API_KEY=
